JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
DATABASE_URL=file:./data/database.sqlite
PUBLIC_ORIGIN=https://showcase.example.com
HTTP_PORT=80

# HTTPS: nginx generates a self-signed certificate automatically on start
# using SSL_DOMAIN as its CN/SAN (IP address or hostname both work). This
# unblocks browser features that require a secure context, like the color
# eyedropper, when the site is only reachable by IP. Browsers will show a
# security warning until this is a real, CA-trusted certificate.
HTTPS_PORT=443
SSL_DOMAIN=localhost

# Once a domain points at the server (A record), set LE_DOMAIN to it and
# run certbot once to get a real, trusted certificate — see the domain
# server block in nginx/nginx.conf. Leave empty if you don't have a domain
# yet; the self-signed fallback above still covers direct-IP access.
LE_DOMAIN=

# Optional: without a key, the AI form uses the local fallback.
OPENAI_API_KEY=API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_MS=120000

# Optional: new requests from the landing page («Оставить заявку») are sent to
# this Telegram chat. Create a bot with @BotFather, send it any message, then
# take chat.id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# Without these, requests are still saved and shown in the admin panel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Subscription: a newly connected store works this many days for free.
TRIAL_DAYS=14

# «Витрина + ИИ»: AI cards per store per calendar month (one draft = 1, a bulk
# upload = the number of products it finds). Can be changed per store in the
# admin panel. Optional prices (rubles per 1M tokens) show the AI spend there.
AI_MONTHLY_LIMIT=100
AI_RUB_PER_1M_INPUT_TOKENS=
AI_RUB_PER_1M_OUTPUT_TOKENS=

# Your contacts, shown to owners on «Подписка и итоги» («Написать администратору»).
SUPPORT_WHATSAPP=
SUPPORT_PHONE=
SUPPORT_TELEGRAM=

# Image optimization.
IMAGE_UPLOAD_MAX_BYTES=15728640
AI_IMAGE_MAX_DIMENSION=512
AI_IMAGE_QUALITY=72
PRODUCT_IMAGE_MAX_DIMENSION=2048
PRODUCT_IMAGE_QUALITY=86
PRODUCT_IMAGE_MAX_BYTES=10485760
