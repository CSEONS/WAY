JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
DATABASE_URL=file:./data/database.sqlite
PUBLIC_ORIGIN=https://showcase.example.com
HTTP_PORT=80

# HTTPS: nginx generates a self-signed certificate automatically on start
# using SSL_DOMAIN as its CN/SAN (IP address or hostname both work). This
# unblocks browser features that require a secure context, like the color
# eyedropper, when the site is only reachable by IP. Browsers will show a
# security warning until this is a real, CA-trusted certificate.
HTTPS_PORT=443
SSL_DOMAIN=localhost

# The site's domain (A record pointing at this server), e.g. example.ru.
# Certificate: nginx/paid-cert/<domain>.crt + .key if you bought one (with
# exactly one pair there SITE_DOMAIN may stay empty — it's taken from the file
# name); otherwise a Let's Encrypt one (LE_DOMAIN below); otherwise self-signed.
SITE_DOMAIN=

# Free Let's Encrypt certificate instead of a purchased one: set LE_DOMAIN to
# the same domain and run certbot once (see README). Leave empty otherwise.
LE_DOMAIN=

# Plans and prices, the trial, AI models and limits, the ruble rate for AI
# spend, contacts, help videos and requisites are set in the admin panel →
# «Настройки», no restart needed. Older installations had them here
# (TRIAL_DAYS, AI_MODEL, AI_PREVIEW_MODEL, AI_PREVIEW_QUALITY, AI_MONTHLY_LIMIT,
# AI_PREVIEW_UNITS, AI_RUB_PER_USD, SUPPORT_*): such values are still picked up
# as the starting point until «Настройки» is saved once.

# AI for product drafts from photos and voice. Any OpenAI-compatible provider
# works; switch by changing these lines and restarting the backend, then pick
# the model the provider names in «Настройки»:
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1     AI_API_STYLE=responses
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1  AI_API_STYLE=chat
#   others with Chat Completions (Yandex AI Studio, DeepSeek, a local server):
#                AI_BASE_URL=<their /v1 address>           AI_API_STYLE=chat
# For drafts from photos the model must understand images. If the provider
# rejects "response_format", set AI_JSON_MODE=off. Check the connection in the
# admin panel: «ИИ-провайдер» → «Проверить». Without a key only a simple text
# draft works. Old names (OPENAI_API_KEY, OPENAI_BASE_URL, …) still work.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_API_STYLE=responses
AI_JSON_MODE=on
AI_TIMEOUT_MS=120000
# Voice goes to /audio/transcriptions — can be another provider than the
# drafts (empty — the same). "off" turns voice input off.
AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_TRANSCRIBE_BASE_URL=
AI_TRANSCRIBE_API_KEY=
# «Превью с ИИ» in the product form: an image model draws a storefront cover
# from the product photo (/images/edits). Model, quality and on/off are in
# «Настройки»; the provider is the one above unless set here, and it must
# support images (OpenAI does). 1024x1280 is 4:5, the shape of a product card
# on the storefront; older models (gpt-image-1.5 and earlier) only take 1024x1536.
AI_PREVIEW_SIZE=1024x1280
AI_PREVIEW_TIMEOUT_MS=150000
AI_PREVIEW_BASE_URL=
AI_PREVIEW_API_KEY=
# Optional: real AI spending straight from OpenAI in the admin panel →
# «Расходы на ИИ» → «Траты на ИИ по дням» (tokens and dollars by day, the same
# figures as platform.openai.com → Usage). Needs an Admin key of the OpenAI
# organization: platform.openai.com → Settings → Organization → Admin keys
# (only the organization owner can make one; a project key won't do). Without
# it the admin panel shows the site's own estimate. OPENAI_ADMIN_BASE_URL only
# if the server reaches OpenAI through a proxy of its own.
OPENAI_ADMIN_KEY=
OPENAI_ADMIN_BASE_URL=

# Optional: new requests from the landing page («Оставить заявку») are sent to
# this Telegram chat. Create a bot with @BotFather, send it any message, then
# take chat.id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# Without these, requests are still saved and shown in the admin panel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Online payment: the owner pays their plan in «Подписка и оплата» through
# ЮKassa and the subscription is extended at once. Empty — the admin takes the
# money as before. ЮKassa works with sole traders and companies only (it
# stopped serving the self-employed on 29.12.2025).
#  - Shop id and secret key: ЮKassa → «Интеграция» → «Ключи API». A test shop
#    (test_ key) takes test cards only.
#  - «Интеграция» → «HTTP-уведомления»: URL https://<SITE_DOMAIN>/api/yookassa/notifications,
#    events payment.succeeded and payment.canceled.
#  - PUBLIC_ORIGIN above must be the site's address: ЮKassa returns the owner there.
# Receipts (54-ФЗ): with «Чеки от ЮKassa» or an online register connected in
# ЮKassa set YOOKASSA_RECEIPTS=on — every payment then carries a receipt sent
# to the owner's email (or phone). YOOKASSA_VAT_CODE: 1 — без НДС, 11 — 22%,
# 7 — 5%, 8 — 7%. YOOKASSA_TAX_SYSTEM: 1 — ОСН, 2 — УСН «доходы»,
# 3 — УСН «доходы минус расходы», 6 — патент; empty — as set in ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPTS=off
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM=

# Server problems (errors 500, failed backups, the server going down) go to
# this chat. Empty — to TELEGRAM_CHAT_ID. Uses the same bot.
TELEGRAM_ALERT_CHAT_ID=

# Backups. Every night at BACKUP_HOUR (server time, see TZ) the database is
# copied to data/backups (the last BACKUP_KEEP_LOCAL copies are kept) and, if
# the S3 settings below are filled, to object storage together with new photos
# (database copies are kept BACKUP_KEEP_DAYS days). On the 1st of each month
# the newest copy in storage is test-restored and the result sent to Telegram.
# Yandex Object Storage: create a bucket and a service account with a static
# access key (role storage.editor). Timeweb: endpoint https://s3.timeweb.cloud.
BACKUP_ENABLED=true
BACKUP_HOUR=4
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_DAYS=30
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=showcase
TZ=Europe/Moscow

# How many proxies stand in front of the backend (nginx from this compose = 1).
# Add one more if the site is also behind Cloudflare or a hosting balancer.
TRUST_PROXY=1

# Image optimization.
IMAGE_UPLOAD_MAX_BYTES=15728640
AI_IMAGE_MAX_DIMENSION=512
AI_IMAGE_QUALITY=72
PRODUCT_IMAGE_MAX_DIMENSION=2048
PRODUCT_IMAGE_QUALITY=86
PRODUCT_IMAGE_MAX_BYTES=10485760
